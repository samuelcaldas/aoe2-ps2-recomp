# Rebuild the licensed runtime source without its game-specific request-queue injection.
# The original dependency checkout remains untouched.
function(aoe2_install_sif runtime_target upstream_source)
    get_target_property(runtime_sources ${runtime_target} SOURCES)
    set(source_count 0)
    foreach(source IN LISTS runtime_sources)
        if(source STREQUAL upstream_source)
            math(EXPR source_count "${source_count} + 1")
        endif()
    endforeach()
    if(NOT source_count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one upstream SIF source, found ${source_count}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream_source}")
    file(READ "${upstream_source}" contents)
    set(begin_marker "            // On real PS2, async NCmds complete via a CDVD DMA interrupt that:")
    set(end_marker "        }\n\n        void callIopRpc(")
    string(FIND "${contents}" "${begin_marker}" begin)
    string(FIND "${contents}" "${end_marker}" end)
    if(begin LESS 0 AND NOT contents MATCHES "kNcmdRingBase|s_pendingNcmdSignals")
        return()
    endif()
    if(begin LESS 0 OR end LESS begin)
        message(FATAL_ERROR "Upstream SIF completion block changed; review request ownership before building")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${contents}" ${begin} ${length} removed)
    string(SHA256 removed_hash "${removed}")
    if(NOT removed_hash STREQUAL "dbce4f4c30686d3b1d8c8d88a4231e4297018d22042f3821ec46588d21034759")
        message(FATAL_ERROR "Upstream SIF completion block changed; review request ownership before building")
    endif()
    if(NOT removed MATCHES "kNcmdRingBase = 0x4F1400u" OR
       NOT removed MATCHES "s_pendingNcmdSignals" OR NOT removed MATCHES "signalSemaphore")
        message(FATAL_ERROR "Upstream SIF completion block does not match the verified legacy injection")
    endif()
    string(SUBSTRING "${contents}" 0 ${begin} prefix)
    string(SUBSTRING "${contents}" ${end} -1 suffix)
    get_filename_component(stubs_directory "${upstream_source}" DIRECTORY)
    string(REPLACE "#include \"Common.h\"" "#include \"${stubs_directory}/Common.h\"" prefix "${prefix}")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/runtime/sif_rpc.cpp")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/runtime")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${prefix}${suffix}" @ONLY)
    list(REMOVE_ITEM runtime_sources "${upstream_source}")
    set_property(TARGET ${runtime_target} PROPERTY SOURCES "${runtime_sources}")
    target_sources(${runtime_target} PRIVATE "${output}")
    target_include_directories(${runtime_target} PRIVATE "${stubs_directory}")
endfunction()
